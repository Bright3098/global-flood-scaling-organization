def map_koppen_group(row: pd.Series) -> str:

    candidates = []
    for c in ["Cli_Zone", "CliType", "CliTypeCHN", "Cli_Zone_C", "Code", "GRIDCODE"]:
        if c in row.index:
            candidates.append(str(row[c]))
    s = " ".join(candidates).strip().upper()

    for c in ["Cli_Zone", "Code", "CliType"]:
        if c in row.index:
            v = str(row[c]).strip().upper()
            if len(v) > 0:
                first = v[0]
                if first == "A":
                    return "I Tropical (A)"
                if first == "B":
                    return "II Arid (B)"
                if first == "C":
                    return "III Temperate (C)"
                if first == "D":
                    return "IV Cold/Continental (D)"
                if first == "E":
                    return "V Polar/Highland (E)"

    # 兜底：中文/英文关键词
    if any(k in s for k in ["TROP", "热", "雨林"]):
        return "I Tropical (A)"
    if any(k in s for k in ["ARID", "DRY", "干", "旱", "沙", "荒"]):
        return "II Arid (B)"
    if any(k in s for k in ["TEMP", "温", "SUBTROP", "亚热"]):
        return "III Temperate (C)"
    if any(k in s for k in ["COLD", "CONTINENT", "冷", "寒", "大陆"]):
        return "IV Cold/Continental (D)"
    if any(k in s for k in ["POLAR", "HIGHLAND", "极", "高原", "冰", "苔原"]):
        return "V Polar/Highland (E)"

    return "Unknown"


def attach_climate_zone(df: pd.DataFrame, climate_shp: str | Path) -> pd.DataFrame:
    try:
        import geopandas as gpd
    except Exception as exc:
        raise ImportError("Climate matching requires geopandas. Install geopandas or set CLIMATE_SHP=None.") from exc

    climate_shp = Path(climate_shp)
    if not climate_shp.exists():
        raise FileNotFoundError(f"CLIMATE_SHP not found: {climate_shp}")

    stations = gpd.GeoDataFrame(
        df.copy(),
        geometry=gpd.points_from_xy(df["lon"], df["lat"]),
        crs="EPSG:4326"
    )
    climate = gpd.read_file(climate_shp)
    if climate.crs is None:
        climate = climate.set_crs("EPSG:4326")
    climate = climate.to_crs("EPSG:4326")

    joined = gpd.sjoin(stations, climate, how="left", predicate="within")
    joined = pd.DataFrame(joined.drop(columns="geometry"))
    joined["koppen5_group"] = joined.apply(map_koppen_group, axis=1)
    return joined


def summarize_one_group(g: pd.DataFrame, var_prefix: str, dir_col: str, sig_col: str) -> Dict[str, float]:
    n_all = int(len(g))
    n_up = int((g[dir_col] == "increase").sum())
    n_down = int((g[dir_col] == "decrease").sum())
    n_none = int((g[dir_col] == "none").sum())
    n_sig_up = int(((g[dir_col] == "increase") & (g[sig_col])).sum())
    n_sig_down = int(((g[dir_col] == "decrease") & (g[sig_col])).sum())
    n_dir = n_up + n_down

    if CLIMATE_NET_DENOMINATOR == "directional":
        denominator_n = n_dir
    else:
        denominator_n = n_all

    net = safe_pct(n_up - n_down, denominator_n)
    ci_low, ci_high = wilson_ci_for_net(n_up, n_down, denominator_n)
    pval = binom_pvalue_two_sided(n_up, n_down)

    return {
        f"{var_prefix}_n_all": n_all,
        f"{var_prefix}_n_up": n_up,
        f"{var_prefix}_n_down": n_down,
        f"{var_prefix}_n_none": n_none,
        f"{var_prefix}_n_directional": n_dir,
        f"{var_prefix}_pct_up_all": safe_pct(n_up, n_all),
        f"{var_prefix}_pct_down_all": safe_pct(n_down, n_all),
        f"{var_prefix}_pct_sig_up_all": safe_pct(n_sig_up, n_all),
        f"{var_prefix}_pct_sig_down_all": safe_pct(n_sig_down, n_all),
        f"{var_prefix}_net_increase_pct": net,
        f"{var_prefix}_net_ci_low": ci_low,
        f"{var_prefix}_net_ci_high": ci_high,
        f"{var_prefix}_binom_p_up_vs_down": pval,
        f"{var_prefix}_net_significant_p05": bool(np.isfinite(pval) and pval < 0.05),
    }


def export_climate_zone_csv(df: pd.DataFrame) -> Optional[pd.DataFrame]:
    if CLIMATE_SHP is None:
        print("[SKIP] CLIMATE_SHP=None, skip climate-zone CSV.")
        return None

    joined = attach_climate_zone(df, CLIMATE_SHP)
    joined.to_csv(OUT_DIR / "04b_station_with_koppen5_group.csv", index=False, encoding="utf-8-sig")

    order = [
        "I Tropical (A)",
        "II Arid (B)",
        "III Temperate (C)",
        "IV Cold/Continental (D)",
        "V Polar/Highland (E)",
    ]

    rows = []
    for group in order:
        g = joined[joined["koppen5_group"] == group].copy()
        if len(g) == 0:
            continue
        row = {"koppen5_group": group}
        row.update(summarize_one_group(g, "R", "R_dir", "R_sig"))
        row.update(summarize_one_group(g, "C", "C_dir", "C_sig"))
        row["x_for_panel_d_C_net_increase_pct"] = row["C_net_increase_pct"]
        row["y_for_panel_d_R_net_increase_pct"] = row["R_net_increase_pct"]
        row["C_xerr_low"] = row["C_net_increase_pct"] - row["C_net_ci_low"]
        row["C_xerr_high"] = row["C_net_ci_high"] - row["C_net_increase_pct"]
        row["R_yerr_low"] = row["R_net_increase_pct"] - row["R_net_ci_low"]
        row["R_yerr_high"] = row["R_net_ci_high"] - row["R_net_increase_pct"]
        rows.append(row)

    out = pd.DataFrame(rows)
    out.to_csv(OUT_DIR / "04_climate_zone_net_trend_summary.csv", index=False, encoding="utf-8-sig")
    return out




def export_area_bin_fraction(
    df: pd.DataFrame,
    dir_col: str,
    var_name: str,
    out_name: str,
    n_bins: int = N_AREA_BINS,
    min_n: int = MIN_N_PER_BIN,
) -> pd.DataFrame:
    
    d = df.dropna(subset=["area_km2", "log10_area"]).copy()
    d = d[d[dir_col].isin(["increase", "decrease", "none"])].copy()
    d = d.sort_values("log10_area").reset_index(drop=True)

    n = len(d)
    if n == 0:
        raise ValueError(f"No data for {var_name} area-bin fraction.")

  
    max_bins_by_min_n = max(1, n // min_n)
    n_bins_eff = max(1, min(n_bins, max_bins_by_min_n))
    bin_ids = np.array_split(np.arange(n), n_bins_eff)

    rows = []
    for i, idx in enumerate(bin_ids, start=1):
        sub = d.iloc[idx]
        n_all = len(sub)
        n_inc = int((sub[dir_col] == "increase").sum())
        n_dec = int((sub[dir_col] == "decrease").sum())
        n_none = int((sub[dir_col] == "none").sum())
        rows.append({
            "var": var_name,
            "bin_id": i,
            "n": n_all,
            "n_increase": n_inc,
            "n_decrease": n_dec,
            "n_none": n_none,
            "fraction_increase": n_inc / n_all,
            "percent_increase": n_inc / n_all * 100,
            "log10_area_min": float(sub["log10_area"].min()),
            "log10_area_median": float(sub["log10_area"].median()),
            "log10_area_max": float(sub["log10_area"].max()),
            "area_km2_median": float(sub["area_km2"].median()),
        })

    out = pd.DataFrame(rows)
    out.to_csv(OUT_DIR / out_name, index=False, encoding="utf-8-sig")

    fit = fit_fraction_vs_logarea(out, x_col="log10_area_median", y_col="percent_increase")
    fit["var"] = var_name
    pd.DataFrame([fit]).to_csv(OUT_DIR / out_name.replace(".csv", "_linear_fit.csv"), index=False, encoding="utf-8-sig")
    return out


def fit_fraction_vs_logarea(tab: pd.DataFrame, x_col: str, y_col: str) -> Dict[str, float]:
    x = pd.to_numeric(tab[x_col], errors="coerce").to_numpy(float)
    y = pd.to_numeric(tab[y_col], errors="coerce").to_numpy(float)
    m = np.isfinite(x) & np.isfinite(y)
    if m.sum() < 3:
        return {"n_points": int(m.sum()), "slope": np.nan, "intercept": np.nan, "r": np.nan, "p": np.nan, "r2": np.nan}
    try:
        from scipy.stats import linregress
        res = linregress(x[m], y[m])
        return {
            "n_points": int(m.sum()),
            "slope": float(res.slope),
            "intercept": float(res.intercept),
            "r": float(res.rvalue),
            "p": float(res.pvalue),
            "r2": float(res.rvalue ** 2),
        }
    except Exception:
        k, b = np.polyfit(x[m], y[m], 1)
        r = np.corrcoef(x[m], y[m])[0, 1]
        return {"n_points": int(m.sum()), "slope": float(k), "intercept": float(b), "r": float(r), "p": np.nan, "r2": float(r**2)}


def export_threshold_scan(
    df: pd.DataFrame,
    dir_col: str,
    var_name: str,
    out_name: str,
    qmin: float = SCAN_QMIN,
    qmax: float = SCAN_QMAX,
    n_q: int = SCAN_N_Q,
    min_n_side: int = SCAN_MIN_N_SIDE,
) -> pd.DataFrame:
    """
    对应第二张图 (b)/(e)：Otsu-like threshold scan。
    J = (p_small - p_large)^2，其中 p 是 increasing fraction。
    """
    d = df.dropna(subset=["area_km2", "log10_area"]).copy()
    d = d[d["area_km2"] > 0].copy()
    trend = (d[dir_col] == "increase").to_numpy(bool)
    logA = d["log10_area"].to_numpy(float)

    candidate_logA = np.quantile(logA, np.linspace(qmin, qmax, n_q))
    rows = []
    for i, th in enumerate(candidate_logA, start=1):
        small = logA <= th
        large = logA > th
        n_small = int(small.sum())
        n_large = int(large.sum())

        if n_small < min_n_side or n_large < min_n_side:
            p_small = np.nan
            p_large = np.nan
            J = np.nan
        else:
            p_small = float(trend[small].mean())
            p_large = float(trend[large].mean())
            J = float((p_small - p_large) ** 2)

        rows.append({
            "var": var_name,
            "candidate_id": i,
            "candidate_log10A": float(th),
            "candidate_A_km2": float(10 ** th),
            "n_small": n_small,
            "n_large": n_large,
            "p_small_increase": p_small,
            "p_large_increase": p_large,
            "J_separation": J,
        })

    out = pd.DataFrame(rows)
    if out["J_separation"].notna().any():
        best_idx = out["J_separation"].idxmax()
        out["is_best_threshold"] = False
        out.loc[best_idx, "is_best_threshold"] = True
        best = out.loc[best_idx].to_dict()
    else:
        out["is_best_threshold"] = False
        best = {}

    out.to_csv(OUT_DIR / out_name, index=False, encoding="utf-8-sig")
    pd.DataFrame([best]).to_csv(OUT_DIR / out_name.replace(".csv", "_best.csv"), index=False, encoding="utf-8-sig")
    return out


def export_moving_window(
    df: pd.DataFrame,
    dir_col: str,
    var_name: str,
    out_name: str,
    window_n: int = MOVING_WINDOW_N,
) -> pd.DataFrame:
  
    d = df.dropna(subset=["area_km2", "log10_area"]).copy()
    d = d[d["area_km2"] > 0].sort_values("area_km2").reset_index(drop=True)

    n = len(d)
    if n == 0:
        raise ValueError(f"No data for {var_name} moving window.")
    if window_n > n:
        window_n = max(5, n // 5)
        print(f"[WARN] MOVING_WINDOW_N is larger than n. Use window_n={window_n}.")

    rows = []
    is_inc = (d[dir_col] == "increase").to_numpy(bool)
    for start in range(0, n - window_n + 1):
        end = start + window_n
        sub = d.iloc[start:end]
        inc = is_inc[start:end]
        rows.append({
            "var": var_name,
            "window_start_index": start,
            "window_end_index": end - 1,
            "window_n": window_n,
            "n_increase": int(inc.sum()),
            "fraction_increase": float(inc.mean()),
            "percent_increase": float(inc.mean() * 100),
            "log10_area_min": float(sub["log10_area"].min()),
            "log10_area_median": float(sub["log10_area"].median()),
            "log10_area_max": float(sub["log10_area"].max()),
            "area_km2_median": float(sub["area_km2"].median()),
        })

    out = pd.DataFrame(rows)
    out.to_csv(OUT_DIR / out_name, index=False, encoding="utf-8-sig")
    return out



