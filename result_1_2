def read_csv_robust(path: str | Path, **kwargs) -> Tuple[pd.DataFrame, str]:
    """
    Robust table reader.


    path = Path(path)

    if not path.exists():
        raise FileNotFoundError(f"MAIN_CSV not found: {path}")

    suffix = path.suffix.lower()


    if suffix in [".xlsx", ".xls"]:
        try:
            # Excel 默认读取第一个 sheet
            # 如需指定 sheet，可在调用时传 sheet_name="xxx"
            sheet_name = kwargs.pop("sheet_name", 0)

            # 去掉 read_excel 不支持的 CSV 参数，避免报错
            csv_only_keys = [
                "encoding",
                "on_bad_lines",
                "low_memory",
                "lineterminator",
                "sep",
                "delimiter",
            ]
            for k in csv_only_keys:
                kwargs.pop(k, None)

            df = pd.read_excel(path, sheet_name=sheet_name, engine="openpyxl", **kwargs)

            return df, f"excel:{sheet_name}"

        except Exception as exc:
            raise RuntimeError(
                f"Cannot read Excel file: {path}\n"
                f"Please check whether the file is a valid .xlsx/.xls file.\n"
                f"Last error: {exc}"
            )


    encodings = ["utf-8-sig", "utf-8", "gbk", "gb18030", "latin1"]
    last_error = None

    for enc in encodings:
        try:
            df = pd.read_csv(path, encoding=enc, **kwargs)
            return df, enc
        except Exception as exc:
            last_error = exc

    raise RuntimeError(f"Cannot read CSV: {path}\nLast error: {last_error}")

def _norm_name(x) -> str:
    return re.sub(r"[^a-z0-9]+", "", str(x).strip().lower())


def find_col(columns: Iterable[str], candidates: Sequence[str], required: bool = True, label: str = "") -> Optional[str]:

    cols = list(columns)
    norm_to_col = {_norm_name(c): c for c in cols}


    for cand in candidates:
        key = _norm_name(cand)
        if key in norm_to_col:
            return norm_to_col[key]

    cand_keys = [_norm_name(c) for c in candidates]
    for col in cols:
        key = _norm_name(col)
        if any(ck and ck in key for ck in cand_keys):
            return col

    if required:
        raise KeyError(
            f"Cannot find required column: {label or candidates}\n"
            f"Tried: {candidates}\nExisting columns: {cols}"
        )
    return None


def to_num(s) -> pd.Series:
    return pd.to_numeric(s, errors="coerce")


def clean_text(x) -> str:
    if pd.isna(x):
        return ""
    return str(x).strip()


def parse_direction(x) -> str:
  
    s = clean_text(x).lower()
    if any(k in s for k in ["increasing", "increase", "upward", "positive", "up", "上升", "增加"]):
        return "increase"
    if any(k in s for k in ["decreasing", "decrease", "downward", "negative", "down", "下降", "减少"]):
        return "decrease"
    return "none"


def parse_significant(x) -> bool:

    s_raw = clean_text(x)
    s = s_raw.lower()

    if "*" in s_raw:
        return True
    if any(k in s for k in ["non-significant", "non significant", "nonsignificant", "not significant", "不显著", "ns"]):
        return False
    if any(k in s for k in ["significant", "sig", "显著"]):
        return True
    return False


def opposite_direction(direction: str) -> str:

    if direction == "increase":
        return "decrease"
    if direction == "decrease":
        return "increase"
    return "none"


def arrow(direction: str) -> str:
    if direction == "increase":
        return "↑"
    if direction == "decrease":
        return "↓"
    return "NS"


def trend_class(direction: str, significant: bool, var_label: str = "") -> str:
 
    if direction == "increase":
        return f"{'Sig' if significant else 'Nsig'} ↑"
    if direction == "decrease":
        return f"{'Sig' if significant else 'Nsig'} ↓"
    return "NS"


def safe_pct(num: float, den: float) -> float:
    return np.nan if den == 0 else num / den * 100.0


def binom_pvalue_two_sided(n_up: int, n_down: int) -> float:

    n = int(n_up + n_down)
    if n <= 0:
        return np.nan
    try:
        from scipy.stats import binomtest
        return float(binomtest(int(n_up), n=n, p=0.5, alternative="two-sided").pvalue)
    except Exception:
        from scipy.stats import binom_test
        return float(binom_test(int(n_up), n=n, p=0.5, alternative="two-sided"))


def wilson_ci_for_net(n_up: int, n_down: int, denominator_n: int, alpha: float = 0.05) -> Tuple[float, float]:

    n_dir = int(n_up + n_down)
    if n_dir <= 0 or denominator_n <= 0:
        return np.nan, np.nan

    try:
        from scipy.stats import norm
        z = float(norm.ppf(1 - alpha / 2))
    except Exception:
        z = 1.96

    p = n_up / n_dir
    denom = 1 + z**2 / n_dir
    center = (p + z**2 / (2 * n_dir)) / denom
    half = z * np.sqrt((p * (1 - p) + z**2 / (4 * n_dir)) / n_dir) / denom
    p_low = max(0.0, center - half)
    p_high = min(1.0, center + half)

    scale = n_dir / denominator_n
    net_low = scale * (2 * p_low - 1) * 100
    net_high = scale * (2 * p_high - 1) * 100
    return float(net_low), float(net_high)



def standardize_station_table(df_raw: pd.DataFrame) -> Tuple[pd.DataFrame, Dict[str, Optional[str]]]:
    col_lon = find_col(df_raw.columns, ["longitude", "lon", "long", "x", "long_org", "lon_org"], True, "longitude")
    col_lat = find_col(df_raw.columns, ["latitude", "lat", "y", "lat_org"], True, "latitude")
    col_area = find_col(df_raw.columns, ["area", "area_km2", "basin_area", "A_km2", "area_calc"], True, "basin area")

    col_station = find_col(df_raw.columns, ["station_id", "grdc_no", "station", "station_name", "name", "river"], False, "station")

    col_R = find_col(df_raw.columns, ["Mean_Intercept", "mean_intercept", "Intercept_mean", "alpha", "R", "R_mean"], True, "Mean_Intercept / R")
    col_beta = find_col(df_raw.columns, ["Mean_Slope", "mean_slope", "Slope_mean", "beta", "Beta", "C", "C_mean"], True, "Mean_Slope / beta")

    col_R_trend = find_col(df_raw.columns, ["Intercept_Trend_MK", "Mean_Intercept_MK", "R_trend", "alpha_trend", "intercept_trend"], True, "Intercept_Trend_MK / R trend")
    col_beta_trend = find_col(df_raw.columns, ["Slope_Trend_MK", "Mean_Slope_MK", "beta_trend", "slope_trend"], True, "Slope_Trend_MK / beta trend")

    out = pd.DataFrame()
    out["station_id"] = df_raw[col_station].astype(str) if col_station else df_raw.index.astype(str)
    out["lon"] = to_num(df_raw[col_lon])
    out["lat"] = to_num(df_raw[col_lat])
    out["area_km2"] = to_num(df_raw[col_area])
    out["log10_area"] = np.log10(out["area_km2"].where(out["area_km2"] > 0))

    out["R"] = to_num(df_raw[col_R])
    out["beta_raw"] = to_num(df_raw[col_beta])
    out["C_1minus_beta"] = 1.0 - out["beta_raw"]

    out["R_trend_raw"] = df_raw[col_R_trend].map(clean_text)
    out["beta_trend_raw"] = df_raw[col_beta_trend].map(clean_text)

    out["R_dir"] = out["R_trend_raw"].map(parse_direction)
    out["R_sig"] = out["R_trend_raw"].map(parse_significant)
    out["R_class"] = [trend_class(d, s) for d, s in zip(out["R_dir"], out["R_sig"])]

    out["beta_dir_raw"] = out["beta_trend_raw"].map(parse_direction)
    out["beta_sig"] = out["beta_trend_raw"].map(parse_significant)


    out["C_dir"] = out["beta_dir_raw"].map(opposite_direction)
    out["C_sig"] = out["beta_sig"]
    out["C_class"] = [trend_class(d, s) for d, s in zip(out["C_dir"], out["C_sig"])]

    out["R_arrow"] = out["R_dir"].map(arrow)
    out["C_arrow"] = out["C_dir"].map(arrow)
    out["beta_arrow_raw"] = out["beta_dir_raw"].map(arrow)

    out["hemisphere"] = np.where(out["lat"] >= 0, "Northern", "Southern")

    out = out.replace([np.inf, -np.inf], np.nan)
    out = out.dropna(subset=["lon", "lat", "area_km2", "R", "beta_raw", "C_1minus_beta"]).copy()
    out = out[(out["area_km2"] > 0) & out["lat"].between(-90, 90)].copy()
    out.loc[out["lon"] > 180, "lon"] -= 360

    if KEEP_ORIGINAL_COLUMNS:
        for c in df_raw.columns:
            new_c = f"raw_{c}"
            if new_c not in out.columns:
                out[new_c] = df_raw.loc[out.index, c].values

    colmap = {
        "lon": col_lon,
        "lat": col_lat,
        "area": col_area,
        "station": col_station,
        "R_from": col_R,
        "beta_from": col_beta,
        "R_trend_from": col_R_trend,
        "beta_trend_from": col_beta_trend,
        "C_definition": "C_1minus_beta = 1 - beta_raw",
        "C_trend_definition": "C_dir is opposite of beta_dir_raw; C_sig equals beta_sig",
    }
    return out, colmap



