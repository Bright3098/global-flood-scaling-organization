def normalize_name(x):

    if pd.isna(x):
        return None
    return str(x).strip().lower()


def detect_round_from_path(path):


    parts = [p.lower() for p in Path(path).parts]
    joined = "/".join(parts)
    
    if "isimip3a" in joined or "3a" in parts:
        return "ISIMIP3a"
    if "isimip3b" in joined or "3b" in parts:
        return "ISIMIP3b"

    if "obsclim" in joined or "counterclim" in joined or "nowatermgt" in joined or "1901irr" in joined:
        return "ISIMIP3a"
    if "ssp126" in joined or "ssp370" in joined or "ssp585" in joined or "historical" in joined:
        return "ISIMIP3b"
    
    return "unknown"


def parse_scaling_rc_file(path):

    path = Path(path)
    filename = path.name
    stem = filename.replace(".nc", "")
    rel = None
    
    rec = {
        "filename": filename,
        "stem": stem,
        "local_path": str(path),
        "relative_path": None,
        "parse_status": "ok",
        
        "isimip_round": detect_round_from_path(path),
        "data_type": "scaling_RC",
        
        "ghm": None,
        "forcing_or_gcm": None,
        "forcing": None,
        "gcm": None,
        "scenario": None,
        "soc": None,
        "variant": None,
        
        "folder_0": None,
        "folder_1": None,
        "folder_2": None,
        "folder_3": None,
        "folder_4": None,
        
        "file_size_mb": np.nan,
        "modified_time": pd.NaT,
    }
    
    try:
        rec["relative_path"] = str(path.relative_to(ROOT_DIR))
    except Exception:
        rec["relative_path"] = str(path)

    try:
        stat = path.stat()
        rec["file_size_mb"] = stat.st_size / 1024 / 1024
        rec["modified_time"] = datetime.fromtimestamp(stat.st_mtime)
    except Exception:
        pass
    

    rel_parts = Path(rec["relative_path"]).parts
    for i in range(min(5, len(rel_parts))):
        rec[f"folder_{i}"] = rel_parts[i]
    
    # scaling_RC__cwatm__20crv3__histsoc__default
    if stem.startswith("scaling_RC__"):
        body = stem.replace("scaling_RC__", "")
        parts = body.split("__")
        
        if len(parts) >= 4:
            rec["ghm"] = normalize_name(parts[0])
            rec["forcing_or_gcm"] = normalize_name(parts[1])
            rec["soc"] = normalize_name(parts[2])
            rec["variant"] = normalize_name(parts[3])
        else:
            rec["parse_status"] = "failed_scaling_rc_filename_parts"
    else:
        rec["parse_status"] = "not_scaling_RC_file"

    pparts = [normalize_name(p) for p in path.parts]
    
  
    rel_parts_low = [normalize_name(p) for p in rel_parts]
    

    round_pos = None
    for i, p in enumerate(rel_parts_low):
        if p in ["3a", "isimip3a", "3b", "isimip3b"]:
            round_pos = i
            break
    
    if round_pos is not None:
        after = rel_parts_low[round_pos + 1:]
        
        if rec["isimip_round"] == "ISIMIP3a":
            # after: ghm / soc / variant / forcing / file
            if len(after) >= 4:
                rec["ghm"] = rec["ghm"] or after[0]
                rec["soc"] = rec["soc"] or after[1]
                rec["variant"] = rec["variant"] or after[2]
                rec["forcing"] = after[3]
                rec["forcing_or_gcm"] = rec["forcing_or_gcm"] or after[3]
                rec["scenario"] = "historical"
        
        elif rec["isimip_round"] == "ISIMIP3b":

            
            if len(after) >= 5:
                rec["ghm"] = rec["ghm"] or after[0]
                
                # 查找 scenario
                scenario_candidates = ["historical", "ssp126", "ssp370", "ssp585"]
                scenario_pos = None
                for j, item in enumerate(after):
                    if item in scenario_candidates:
                        scenario_pos = j
                        break
                
                if scenario_pos is not None:
                    rec["scenario"] = after[scenario_pos]
                    
                    # scenario 前面最可能是 gcm
                    if scenario_pos - 1 >= 1:
                        rec["gcm"] = after[scenario_pos - 1]
                        rec["forcing_or_gcm"] = rec["forcing_or_gcm"] or after[scenario_pos - 1]
                    
                    # scenario 后面可能是 soc / variant
                    if scenario_pos + 1 < len(after):
                        rec["soc"] = rec["soc"] or after[scenario_pos + 1]
                    if scenario_pos + 2 < len(after):
                        # 最后一项是 filename，不要当 variant
                        if not after[scenario_pos + 2].endswith(".nc"):
                            rec["variant"] = rec["variant"] or after[scenario_pos + 2]
    
    # -------- 3) 根据 ISIMIP round 决定 forcing/gcm 字段 --------
    if rec["isimip_round"] == "ISIMIP3a":
        rec["forcing"] = rec["forcing"] or rec["forcing_or_gcm"]
        rec["gcm"] = None
        rec["scenario"] = rec["scenario"] or "historical"
    
    elif rec["isimip_round"] == "ISIMIP3b":
        rec["gcm"] = rec["gcm"] or rec["forcing_or_gcm"]
        rec["forcing"] = None
    
    return rec



